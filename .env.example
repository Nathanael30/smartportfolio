# =========================================================================
# SMARTPORTFOLIO SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your actual credentials.
# =========================================================================

# Database Setup (PostgreSQL)
DATABASE_URL=postgresql://smart_user:secure_pwd@localhost:5432/smartportfolio_db

# Cache Setup (Redis)
REDIS_URL=redis://localhost:6379/0

# Zerodha Kite Connect Credentials
KITE_API_KEY=your_kite_api_key_here
KITE_ACCESS_TOKEN=your_kite_access_token_here

# Deployment Modes
ENV=development
DEBUG=True
PORT=8000
